# Comma-separated key pool (>= 2). Key ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your-gemini-key-1,your-gemini-key-2
# Any LiteLLM model name. Keys must belong to that provider.
LLM_MODEL=gemini/gemini-2.0-flash
# SQLite file; keep it under the /data volume so history survives restarts.
DATABASE_URL=sqlite:////data/app.db
# Comma-separated CORS origins (add your deployed frontend URL).
ALLOWED_ORIGINS=http://localhost:3000
# true enables the X-Simulate-Failure header (must be true on the deployed backend).
ENABLE_FAILURE_SIMULATION=true
# Optional
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
CACHE_TYPE=local
LLM_TIMEOUT=30
# Frontend build-time: public URL of the backend.
VITE_API_URL=http://localhost:8000
